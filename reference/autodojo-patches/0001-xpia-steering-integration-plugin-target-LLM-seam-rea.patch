@@ -585,6 +585,23 @@ class DojoASREvaluator:
                 llm=model, model_id=model_id, defense=None,
                 system_message_name=None, system_message=None,
             ))
+        # ── xpia-steering integration ──────────────────────────────────────────
+        # When the defense lives INSIDE the target LLM element (a plugin target,
+        # e.g. activation steering during generation), `defense=None` above makes
+        # the reachability pipeline share the DEFENDED element — but this class's
+        # own design note says reachability must run undefended ("defenses can
+        # rewrite tool outputs and skew the trace"; a steered agent can likewise
+        # change which vectors it reads). AUTODOJO_REACHABILITY_LLM names a second
+        # llm spec (typically the same plugin with the defense off) to build the
+        # reachability pipeline from instead.
+        reach_spec = os.environ.get("AUTODOJO_REACHABILITY_LLM")
+        if reach_spec:
+            self.reachability_pipeline = AgentPipeline.from_config(PipelineConfig(
+                llm=reach_spec, model_id=model_id, defense=None,
+                system_message_name=None, system_message=None,
+            ))
+            print(f"[DojoASREvaluator] reachability pipeline overridden: "
+                  f"AUTODOJO_REACHABILITY_LLM={reach_spec}")
         print(f"[DojoASREvaluator] suite={suite_name}, model={model}, "
               f"model_id={model_id}, defense={defense}, "
               f"reachability_pipeline={'shared' if defense is None else 'no-defense (separate)'}"
@@ -1405,6 +1422,13 @@ def main() -> None:
             args.target_model_id if (args.target_model == "vllm_parsed" and args.target_model_id)
             else args.target_model
         )
+        # xpia-steering integration: a "plugin:<module>?k=v" target spec is not a
+        # usable path segment; require the explicit id instead (fail fast).
+        if args.target_model.startswith("plugin:"):
+            if not args.target_model_id:
+                raise ValueError("--target-model plugin:... requires --target-model-id "
+                                 "(used for the variants cache path)")
+            model_name = args.target_model_id
         defense_name = args.defense or "no_defense"
         cache_dir = OUTPUT_CACHE_DIR / suite_name / model_name / defense_name
         cache_dir.mkdir(parents=True, exist_ok=True)
