         # Local vLLM server via OpenAI-compatible API
         port = os.getenv("LOCAL_LLM_PORT", 8000)
         client = openai.OpenAI(
diff --git a/agentdojo/variant_generation/llm_utils.py b/agentdojo/variant_generation/llm_utils.py
index 7e88aed..f7f1be5 100644
--- a/agentdojo/variant_generation/llm_utils.py
+++ b/agentdojo/variant_generation/llm_utils.py
@@ -59,9 +59,152 @@ PROVIDERS = {
         "api_key_env": "GEMINI_API_KEY",
         "client_type": "google",
     },
+    # xpia-steering integration: Azure OpenAI deployment reached with an az-cli
+    # AAD bearer token (no API key). Endpoint from XPIA_JUDGE_ENDPOINT (the repo's
